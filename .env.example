# ---- Extraction: NVIDIA build (NIM), OpenAI-compatible ----
# Get a key at https://build.nvidia.com/settings/api-keys  (starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick a CURRENT instruct model from https://build.nvidia.com/explore — IDs change often.
NVIDIA_MODEL=openai/gpt-oss-120b            # verified live Aug 2026; catalog IDs are retired often

# ---- Voice: Sarvam (Saaras) speech-to-text ----
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# saaras:v3 is current. mode=codemix keeps Hinglish in Roman script (best for extraction).
SARVAM_MODEL=saaras:v3
SARVAM_MODE=codemix
