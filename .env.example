# ---------------------------------------------------------------------------
# Extraction: Anthropic (default provider)
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=
# Haiku 4.5 is the default, chosen by measurement against this account's model list:
# fastest of the four probed (1.1-1.3s for a full habits slice versus 1.9s), cheapest,
# correct on the Hinglish probe, and the one that still accepts temperature 0 - which a
# medical form needs, because the same reply must fill the same fields every time.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional. Defaults to 0. A newer model that rejects the parameter has it dropped
# automatically on the first 400, so switching ANTHROPIC_MODEL just works.
# ANTHROPIC_TEMPERATURE=0
# Only for a gateway or proxy. Leave unset for api.anthropic.com.
# ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# Voice input: Sarvam (Saaras) speech-to-text
# ---------------------------------------------------------------------------
# Get a key at https://dashboard.sarvam.ai
# The locally-right pick: saaras is trained on Indian-accented English and Hinglish,
# and mode=codemix returns mixed Hindi/English in Roman script - which is also the
# easiest thing for the extraction step to read.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=codemix

# ---------------------------------------------------------------------------
# The assistant's voice (chat mode)
# ---------------------------------------------------------------------------
# No key, and nothing to configure. Anthropic has no text-to-speech endpoint, and this
# app does not reach for a second vendor to get one - the assistant speaks through the
# browser's own speechSynthesis. Free, offline, instant, and no audio of a patient's
# answers ever leaves the device. Every line is on screen as text regardless.
