# ---------------------------------------------------------------------------
# Extraction: Anthropic (default provider)
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=
# claude-sonnet-5 is the default. Reading loose Hinglish prose into a fixed schema is
# where a stronger model earns its keep, and the prompts here are tiny (one schema slice
# plus one reply). Set claude-haiku-4-5-20251001 to trade a little accuracy for latency.
ANTHROPIC_MODEL=claude-sonnet-5
# Only for a gateway or proxy. Leave unset for api.anthropic.com.
# ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# Voice input: Sarvam (Saaras) speech-to-text
# ---------------------------------------------------------------------------
# Get a key at https://dashboard.sarvam.ai
# The locally-right pick: saaras is trained on Indian-accented English and Hinglish,
# and mode=codemix returns mixed Hindi/English in Roman script - which is also the
# easiest thing for the extraction step to read.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=codemix

# ---------------------------------------------------------------------------
# The assistant's voice (chat mode)
# ---------------------------------------------------------------------------
# No key, and nothing to configure. Anthropic has no text-to-speech endpoint, and this
# app does not reach for a second vendor to get one - the assistant speaks through the
# browser's own speechSynthesis. Free, offline, instant, and no audio of a patient's
# answers ever leaves the device. Every line is on screen as text regardless.

# ---------------------------------------------------------------------------
# Optional: NVIDIA NIM as an alternative extraction provider
# ---------------------------------------------------------------------------
# NIM speaks the OpenAI wire format, so the openai SDK covers it. Set
# EXTRACT_PROVIDER=nvidia to force it; otherwise it is used only when
# ANTHROPIC_API_KEY is absent. Free tier, no card: https://build.nvidia.com/settings/api-keys
# EXTRACT_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Catalog IDs are retired often - verify at https://build.nvidia.com/explore
NVIDIA_MODEL=openai/gpt-oss-20b
# Measured on this account: gpt-oss-20b at "low" answered in 4.7s versus 94-120s for
# gpt-oss-120b at its default effort. Set "none" to omit the field entirely.
NVIDIA_REASONING_EFFORT=low
